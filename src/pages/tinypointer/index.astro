---
/**
 * The app was renamed from Tiny Pointer to Hand Pointer. Old links to
 * /tinypointer land here and move on to /handpointer (static hosting such as
 * GitHub Pages has no server-side redirects).
 */
import { url } from '../../lib/url';

// relative, so it also works locally and on previews; canonical stays absolute
const target = url('/handpointer/');
const canonical = new URL(target, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Hand Pointer</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>Tiny Pointer is now <a href={target}>Hand Pointer</a>.</p>
  </body>
</html>
