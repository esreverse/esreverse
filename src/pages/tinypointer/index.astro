---
/**
 * TinyPointer product page – a vertical scroll story.
 *
 * Layers (all inside .story):
 *   1. .stage      sticky "desktop" (wallpaper), stays put while the story scrolls
 *   2. .steps      the scrolling text and the sheets of paper
 *   3. .hand-layer sticky layer with the TinyPointer hand, above the sheets
 *
 * The hand rises in with a CSS scroll-driven animation. Once it has arrived,
 * it follows the mouse (fine pointers only) and the hand toolbar appears.
 * On the sheets the visitor can try each feature (see Sheet.astro).
 */
import '@fontsource-variable/playpen-sans/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Sheet from '../../components/tinypointer/Sheet.astro';
import HandToolbar, { type HandChoice } from '../../components/tinypointer/HandToolbar.astro';
import DesktopIcons from '../../components/tinypointer/DesktopIcons.astro';
import XdLogo from '../../components/XdLogo.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import { url } from '../../lib/url';

import handGlove from '../../assets/tinypointer/hand-glove.png';
import handCookie from '../../assets/tinypointer/hand-cookie.png';
import handChoco from '../../assets/tinypointer/hand-choco.png';
import handTree from '../../assets/tinypointer/hand-tree.png';
import thumbGlove from '../../assets/tinypointer/thumbs/glove.png';
import thumbCookie from '../../assets/tinypointer/thumbs/cookie.png';
import thumbChoco from '../../assets/tinypointer/thumbs/choco.png';
import thumbTree from '../../assets/tinypointer/thumbs/tree.png';
import stickGlove from '../../assets/tinypointer/sticks/glove.png';
import stickCookie from '../../assets/tinypointer/sticks/cookie.png';
import stickChoco from '../../assets/tinypointer/sticks/choco.png';
import stickTree from '../../assets/tinypointer/sticks/tree.png';

const downloadUrl = 'https://github.com/esreverse/tinypointer/releases/latest/download/TinyPointer.dmg';
const repoUrl = 'https://github.com/esreverse/tinypointer';
const tinyHandUrl = 'https://github.com/nilbuild/tinyhand';
const tinyHandAuthorUrl = 'https://github.com/nilbuild';
const screenBrushUrl = 'https://imagestudiopro.com/screenbrush/';

const handSizes = 'clamp(180px, 22vw, 320px)';
// tip: where the ink comes out, as fractions of the image (measured: topmost
// opaque pixel of the finger, plus 1% so the ink starts on the finger pad)
const handDefs = [
  { id: 'glove', label: 'White glove', image: handGlove, thumb: thumbGlove, stick: stickGlove, tip: [0.461, 0.105] },
  { id: 'cookie', label: 'Gingerbread', image: handCookie, thumb: thumbCookie, stick: stickCookie, tip: [0.414, 0.108] },
  { id: 'choco', label: 'Chocolate', image: handChoco, thumb: thumbChoco, stick: stickChoco, tip: [0.47, 0.125] },
  { id: 'tree', label: 'Christmas tree', image: handTree, thumb: thumbTree, stick: stickTree, tip: [0.423, 0.108] },
];
const hands: HandChoice[] = await Promise.all(
  handDefs.map(async ({ id, label, image, thumb, stick, tip }) => {
    const optimized = await getImage({ src: image, widths: [320, 640, 960], format: 'webp' });
    // a thin slice of the stick, repeated downwards to make it longer
    const stickSlice = await getImage({ src: stick, width: 480, format: 'webp' });
    return {
      id,
      label,
      thumb,
      src: optimized.src,
      srcset: optimized.srcSet.attribute,
      stick: stickSlice.src,
      tipX: tip[0],
      tipY: tip[1],
    };
  }),
);
---

<Base
  title="TinyPointer – A tiny hand on a stick for your Mac"
  description="TinyPointer turns your cursor into a hand that points, taps and draws on top of everything on screen. Free for macOS."
>
  <a class="home-link" href={url('/')}>
    <XdLogo class="home-link__logo" />
    <span class="visually-hidden">Back to esreverse.com</span>
  </a>

  <main class="story">
    <div class="stage" aria-hidden="true">
      <DesktopIcons />
    </div>

    <div class="steps">
      <section class="step step--intro">
        <h1 class="step__title"><span>Imagine this is your desktop.</span></h1>
      </section>

      <section class="step step--hand">
        <h2 class="step__title"><span>And you need a hand to point out some things.</span></h2>
      </section>

      <section class="step step--sheet">
        <Sheet feature="draw" hint="Draw something now">
          <h2 class="sheet-title" slot="title"><span>Imagine you could draw anywhere on your screen.</span></h2>
          <Fragment slot="shortcut">In the app: hold and drag to draw · <kbd>⌃⇥</kbd> turns the pointer on and off</Fragment>
        </Sheet>
      </section>

      <section class="step step--sheet">
        <Sheet feature="rainbow" hint="Draw in rainbow colours now">
          <h2 class="sheet-title" slot="title"><span>In all colors of the rainbow.</span></h2>
          <Fragment slot="shortcut">In the app: press <kbd>R</kbd> for rainbow ink, <kbd>A</kbd> for automatic colour</Fragment>
        </Sheet>
      </section>

      <section class="step step--sheet">
        <Sheet feature="stamp" hint="Click to stamp numbers now">
          <h2 class="sheet-title" slot="title"><span>Imagine you could stamp numbers to describe an order or select options.</span></h2>
          <Fragment slot="shortcut">In the app: hold <kbd>⌥</kbd> and click</Fragment>
        </Sheet>
      </section>

      <section class="step step--sheet">
        <Sheet feature="arrow" hint="Draw an arrow now">
          <h2 class="sheet-title" slot="title"><span>Then imagine you could also draw arrows.</span></h2>
          <Fragment slot="shortcut">In the app: hold <kbd>⌃</kbd> and drag</Fragment>
        </Sheet>
      </section>

      <section class="step step--outro" aria-labelledby="outro-title">
        <p class="step__title outro__lead">
          <span
            >Imagine <a class="hover-link" href={tinyHandUrl}>TinyHand</a> and <a
              class="hover-link"
              href={screenBrushUrl}>ScreenBrush</a
            > had a baby.</span
          >
        </p>
        <h2 class="step__title outro__lead" id="outro-title"><span>This is TinyPointer.</span></h2>
        <a class="download" href={downloadUrl} data-cursor-grow>
          Download for macOS <ArrowIcon tight bold />
        </a>
        <footer class="outro__footer">
          <p class="outro__thanks">
            Big thanks to <a class="hover-link" href={tinyHandAuthorUrl}>Kamran Ahmed</a> for the brilliant
            idea of a tiny hand on a stick, and for building <a class="hover-link" href={tinyHandUrl}
              >TinyHand</a
            >, the app TinyPointer grew out of.
          </p>
          <p class="outro__meta">
            Free &amp; open source · macOS 13 or later · Apple Silicon &amp; Intel · Signed &amp; notarized
            by Apple · <a class="link" href={repoUrl}>GitHub</a>
          </p>
        </footer>
      </section>
    </div>

    <div class="hand-layer" aria-hidden="true">
      <div
        class="hand-rig"
        style={`--tip-x: ${hands[0].tipX * 100}%; --tip-y: ${hands[0].tipY * 100}%`}
        data-hand-rig
      >
        <div class="hand-body" style={`--stick: url(${hands[0].stick})`} data-hand-body>
          <img
            class="hand"
            src={hands[0].src}
            srcset={hands[0].srcset}
            sizes={handSizes}
            alt=""
            decoding="async"
            data-hand
          />
          <div class="hand-stick"></div>
        </div>
      </div>
    </div>
  </main>

  <HandToolbar hands={hands} />
</Base>

<script>
  /**
   * Hand behaviour:
   * - "arrived" once the hand step has scrolled past the upper third
   *   (the CSS scroll animation has then brought the hand in)
   * - while arrived and a mouse is used, the fingertip eases towards the pointer
   */
  const rig = document.querySelector<HTMLElement>('[data-hand-rig]');
  const img = document.querySelector<HTMLImageElement>('[data-hand]');
  const body = document.querySelector<HTMLElement>('[data-hand-body]');
  const trigger = document.querySelector<HTMLElement>('.step--hand');
  const outro = document.querySelector<HTMLElement>('.step--outro');
  const root = document.documentElement;
  const canFollow = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The fingertip (where the ink comes out) is given per hand as --tip-x/--tip-y,
  // fractions of the image. All rotations and the press pivot around it, so the
  // tip sits exactly at that point of the rig, whatever the tilt.
  const tipOf = (el: HTMLElement) => ({
    x: parseFloat(el.style.getPropertyValue('--tip-x')) / 100,
    y: parseFloat(el.style.getPropertyValue('--tip-y')) / 100,
  });

  const layer = document.querySelector<HTMLElement>('.hand-layer');

  // Press and shadow, as in the app (ArmView.swift): while pressed the hand is
  // 6% smaller and sits closer to the surface (80% less lift), so its shadow
  // moves in and gets softer. After release it eases back at 0.18 per frame.
  const LIFT = 0.06; // of the viewport height
  const PRESS_SHRINK = 0.06;

  if (rig && img && trigger && body && layer) {
    let pointer: { x: number; y: number } | null = null;
    let offset = { x: 0, y: 0 };
    let tilt = 0;
    let held = false;
    let press = 0;
    let lock = 0; // 0 = eased, 1 = fingertip locked to the pointer

    window.addEventListener('tinypointer:hand', (event) => {
      const { src, srcset, stick, tipX, tipY } = (
        event as CustomEvent<{ src: string; srcset: string; stick: string; tipX: string; tipY: string }>
      ).detail;
      img.srcset = srcset;
      img.src = src;
      body.style.setProperty('--stick', `url(${stick})`);
      rig.style.setProperty('--tip-x', `${Number(tipX) * 100}%`);
      rig.style.setProperty('--tip-y', `${Number(tipY) * 100}%`);
    });

    if (canFollow) {
      // Browsers only report the pointer position with an event. Besides moves,
      // take it from wheel/trackpad scrolling and from content sliding under a
      // resting pointer, so the hand finds the pointer as soon as it appears.
      const track = (e: MouseEvent) => (pointer = { x: e.clientX, y: e.clientY });
      for (const type of ['pointermove', 'pointerover', 'wheel'] as const) {
        window.addEventListener(type, track, { passive: true });
      }
      root.addEventListener('pointerleave', () => (pointer = null));
      window.addEventListener('pointerdown', (e) => {
        if (e.button === 0 && root.hasAttribute('data-hand-following')) {
          held = true;
          press = 1;
        }
      });
      window.addEventListener('pointerup', () => (held = false));
    }

    const frame = () => {
      const arrived = trigger.getBoundingClientRect().top < window.innerHeight * 0.3;
      root.toggleAttribute('data-hand-arrived', arrived);
      // the hand toolbar is only needed while the sheets are on screen
      const outroReached = !!outro && outro.getBoundingClientRect().top < window.innerHeight * 0.6;
      root.toggleAttribute('data-toolbar', arrived && !outroReached);
      const following = arrived && canFollow && pointer !== null;
      root.toggleAttribute('data-hand-following', following);

      let target = { x: 0, y: 0 };
      if (following && pointer) {
        const tip = tipOf(rig);
        const restX = rig.offsetLeft + tip.x * rig.offsetWidth;
        const restY = rig.offsetTop + tip.y * rig.offsetHeight;
        target = { x: pointer.x - restX, y: pointer.y - restY };
      }

      // While following, the fingertip sits exactly on the pointer (as in the
      // app), so the ink never runs ahead of the hand. Only arriving and
      // returning to rest are eased. A little tilt comes from the speed.
      // ramp the lock up over a few frames so the hand doesn't jump when it starts following
      lock += ((following ? 1 : 0) - lock) * 0.12;
      const ease = reduced ? 1 : following ? 0.22 + 0.78 * Math.min(1, lock * 1.25) : 0.22;
      const dx = (target.x - offset.x) * ease;
      offset = { x: offset.x + dx, y: offset.y + (target.y - offset.y) * ease };
      tilt += (Math.max(-8, Math.min(8, dx * 0.25)) - tilt) * 0.15;
      rig.style.transform = `translate(${offset.x}px, ${offset.y}px) rotate(${tilt}deg)`;

      if (!held) press += (0 - press) * 0.18;
      const lift = LIFT * window.innerHeight * (1 - 0.8 * press);
      const blur = Math.max(1, lift * 0.35) + 5 * press;
      body.style.scale = String(1 - PRESS_SHRINK * press);
      layer.style.filter = `drop-shadow(${(lift * 0.6).toFixed(1)}px ${lift.toFixed(1)}px ${(blur * 2).toFixed(1)}px rgb(0 0 0 / ${(0.26 + 0.02 * press).toFixed(3)}))`;

      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style>
  /* --- Page-level tokens ---------------------------------------------------- */
  /* Classic black-and-white look on a plain grey desktop.
     Only the hands and the ink are in colour. */
  :global(body) {
    --story-text: var(--color-black);
    --desktop-grey: #b4b4b4;

    background: var(--desktop-grey);
  }

  /* DARK MODE – disabled while the light mode is being refined.
   Remove this comment wrapper to switch it back on.
@media (prefers-color-scheme: dark) {
    :global(body) {
      --desktop-top: #1d1d3a;
      --desktop-mid: #2b2850;
      --desktop-bottom: #3a3a1c;
      --story-text: var(--color-lilac-50);
    }
  }
*/

  /* The hand is the pointer while it follows the mouse. */
  :global(html[data-hand-following]),
  :global(html[data-hand-following] *) {
    cursor: none !important;
  }

  /* --- Home link (XD mark, top right as on the home page) ------------------- */
  .home-link {
    position: fixed;
    z-index: 10;
    top: 40px;
    right: 40px;
    color: var(--story-text);
  }

  .home-link :global(.home-link__logo) {
    width: 64px;
  }

  @media (max-width: 767px) {
    .home-link {
      top: 32px;
      right: 32px;
    }

    .home-link :global(.home-link__logo) {
      width: 51px;
    }
  }

  /* --- Story layers ---------------------------------------------------------- */
  .story {
    position: relative;
    /* makes the hand trigger's timeline visible to the hand */
    timeline-scope: --hand-in;
    color: var(--story-text);
  }

  .stage {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    overflow: hidden;
  }


  .steps {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
  }

  /* Last in the DOM so it paints above the sheets; `bottom: 0` keeps it
     pinned to the viewport for the whole story. */
  .hand-layer {
    position: sticky;
    z-index: 3; /* above the sheets and the toolbar */
    bottom: 0;
    height: 100svh;
    margin-top: -100svh;
    pointer-events: none;
    overflow: clip;
    /* resting shadow of the lifted hand (updated live by the script) */
    filter: drop-shadow(3.2svh 5.4svh 3.8svh rgb(0 0 0 / 0.26));
  }

  /* --- Hand ----------------------------------------------------------------- */
  .hand-rig {
    position: absolute;
    right: 12%;
    /* the stick runs out of the bottom edge of the screen */
    bottom: -10svh;
    width: clamp(180px, 22vw, 320px);
    aspect-ratio: 2 / 3;
    transform-origin: var(--tip-x) var(--tip-y);
    will-change: transform;
  }

  .hand-body {
    position: relative;
    rotate: -12deg;
    /* tilt and presses pivot around the fingertip */
    transform-origin: var(--tip-x) var(--tip-y);
  }

  .hand {
    position: relative;
    width: 100%;
    height: auto;
  }

  /* Longer stick: a slice of the hand's own stick, repeated downwards.
     It starts above the rounded end of the stick in the image (87% of its
     height) and runs far below the screen edge. */
  .hand-stick {
    position: absolute;
    top: 87%;
    left: 0;
    width: 100%;
    height: 150svh;
    background: var(--stick) top center / 100% auto repeat-y;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .step--hand {
        view-timeline: --hand-in block;
      }

      .hand-body {
        animation: hand-in linear both;
        animation-timeline: --hand-in;
        animation-range: entry 30% contain 30%;
      }
    }
  }

  @keyframes hand-in {
    from {
      translate: 0 110%;
      rotate: 8deg;
    }
    to {
      translate: 0 0;
      rotate: -12deg;
    }
  }

  /* --- Steps ----------------------------------------------------------------- */
  .step {
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 96px var(--gutter);
  }

  /* one headline size for the whole page (same as the sheet headlines) */
  .step__title {
    max-width: 20ch;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 400;
    text-align: center;
  }


  /* The first two lines share the sheets' column and left edge. */
  .step--intro .step__title,
  .step--hand .step__title {
    width: min(880px, 100%, 130svh);
    max-width: none;
    text-align: left;
  }

  .step--intro .step__title > span,
  .step--hand .step__title > span {
    /* keep the lines short enough to read as a headline */
    display: inline;
  }

  .step--intro .step__title,
  .step--hand .step__title {
    padding-right: 20%;
  }

  /* Vertically centred on the first screen … */
  .step--intro {
    height: 100svh;
    min-height: 0;
  }

  /* … while the start of the next line already peeks in from below.
     Every following screen is shorter than the viewport, so the next one
     always peeks in at the bottom. */
  .step--hand {
    min-height: 62svh;
    margin-top: -9svh;
    padding-top: 0;
    padding-bottom: 0;
    place-items: start center;
  }

  /* 9svh + 9svh between shortcut hint and the next headline */
  .step--sheet {
    min-height: 0;
    padding-block: 9svh;
  }

  .sheet-title {
    max-width: 20ch;
    font-size: clamp(2rem, 4.5vw, 3.75rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 400;
    /* with the 14px gap: 3 × the former 32px between headline and window */
    margin-bottom: 82px;
  }

  /* --- Outro ----------------------------------------------------------------- */
  .step--outro {
    position: relative;
    min-height: 100svh;
    align-content: center;
    gap: 0;
  }

  .outro__lead {
    max-width: 22ch;
  }

  /* one empty line between the two sentences */
  .outro__lead + .outro__lead {
    margin-top: 1.1em;
  }

  /* classic default button: rounded, with a thick outer ring */
  .download {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: clamp(64px, 12svh, 128px);
    padding: 12px 28px;
    border-radius: 12px;
    outline: 3px solid var(--color-black);
    outline-offset: 3px;
    background: var(--color-white);
    color: var(--color-black);
    font-size: var(--text-body);
    line-height: var(--leading-body);
    font-weight: 600;
    text-decoration: none;
    transition: scale 0.15s var(--ease-out);
  }

  /* hover inverts it, a press pushes it in a little */
  .download:hover {
    background: var(--color-black);
    color: var(--color-white);
  }

  .download:active {
    scale: 0.97;
  }

  .download :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* links in running text: underlined on hover only */
  .hover-link {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: transparent;
    text-underline-offset: 0.18em;
    transition: text-decoration-color 0.2s;
  }

  .hover-link:hover {
    text-decoration-color: currentColor;
    /* a little lighter than the letters' stems */
    text-decoration-thickness: 0.055em;
  }

  /* thanks and facts at the very bottom of the page, directly on the desktop */
  .outro__footer {
    position: absolute;
    left: 50%;
    bottom: 32px;
    translate: -50% 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    /* two thirds of the page width, so the lines don't run too long */
    width: min(66.667%, 100% - 2 * var(--gutter));
  }

  .outro__thanks {
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 0.75rem; /* same as the line below */
    line-height: 1.6;
    text-align: center;
  }

  .outro__meta {
    width: max-content;
    max-width: 100%;
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 0.75rem;
    line-height: 1.6;
    text-align: center;
  }
</style>
