---
/**
 * Quite Handy moved to quitehandy.app. Kept for a few weeks for people who got this link. The update feed public/quitehandy/appcast.xml stays (installs of 1.7.0 to 2.3 read it).
 * Static hosting such as GitHub Pages has no server-side redirects, so this page moves on.
 */
const target = 'https://quitehandy.app/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Quite Handy</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>Quite Handy has moved to <a href={target}>quitehandy.app</a>.</p>
  </body>
</html>
