---
/**
 * Base document layout shared by all pages.
 * No framework runtime, no tracking – just HTML, CSS and a few tiny scripts.
 */
import '../styles/global.css';
import SmoothScroll from '../components/SmoothScroll.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  /** Path to the Open Graph image, relative to the site root */
  ogImage?: string;
  /** Light-mode browser UI colour */
  themeColor?: string;
  /** Own icon set for a page (favicon + apple-touch-icon), e.g. a product page */
  icons?: { favicon: string; appleTouch: string };
}

const {
  title,
  description,
  ogImage = '/og-image.png',
  themeColor = '#f5f6ff',
  icons,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(url(ogImage), Astro.site);
// Bump when a preview image changes: social networks cache previews per image URL.
ogImageUrl.searchParams.set('v', '5');
// The GitHub Pages preview must not compete with the real domain in search engines.
const isPreview = import.meta.env.BASE_URL !== '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="theme-color" content={themeColor} />
    <!-- Dark mode is disabled for now:
    <meta name="theme-color" content="#0d0d14" media="(prefers-color-scheme: dark)" /> -->

    {
      icons ? (
        <>
          <link rel="icon" href={url(icons.favicon)} />
          <link rel="apple-touch-icon" href={url(icons.appleTouch)} />
        </>
      ) : (
        <>
          <link rel="icon" href={url('/icons/favicon-light.png')} media="(prefers-color-scheme: light)" />
          <link rel="icon" href={url('/icons/favicon-dark.png')} media="(prefers-color-scheme: dark)" />
          <link rel="apple-touch-icon" href={url('/icons/apple-touch-icon.png')} />
        </>
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="robots" content={isPreview ? 'noindex' : 'max-image-preview:large'} />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <SmoothScroll />
  </body>
</html>
