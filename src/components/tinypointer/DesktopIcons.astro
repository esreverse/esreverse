---
/**
 * 1-bit desktop icons in the spirit of the classic Mac desktop.
 * Drawn here on a 32 × 32 pixel grid (no original Apple artwork).
 * "GitHub" and "LinkedIn" are links; "Screenshots" and "Hands" open dialogs.
 */
type Kind = 'disk' | 'folder' | 'document' | 'trash' | 'globe';

// slot: 0, 1, 2 … from the top; -1, -2 … from the bottom.
// The top right corner is left to the XD logo.
type Icon = {
  kind: Kind;
  label: string;
  side: 'left' | 'right';
  slot: number;
  /** id of a RetroDialog to open */
  dialog?: string;
  /** link target */
  href?: string;
  /** accessible name for clickable icons */
  name?: string;
};

const icons: Icon[] = [
  { kind: 'disk', label: 'Macintosh HD', side: 'left', slot: 0 },
  {
    kind: 'document',
    label: 'GitHub',
    side: 'left',
    slot: 1,
    href: 'https://github.com/esreverse/tinypointer',
    name: 'TinyPointer on GitHub',
  },
  {
    kind: 'globe',
    label: 'LinkedIn',
    side: 'left',
    slot: 2,
    href: 'https://www.linkedin.com/in/eric-singhartinger/',
    name: 'Eric Singhartinger on LinkedIn',
  },
  { kind: 'folder', label: 'Screenshots', side: 'left', slot: -2, dialog: 'screenshots', name: 'Screenshots of the settings' },
  { kind: 'folder', label: 'Hands', side: 'left', slot: -1, dialog: 'own-hand', name: 'Hands: make your own hand' },
  { kind: 'trash', label: 'Trash', side: 'right', slot: -1 },
];
---

<ul class="icons" role="list">
  {
    icons.map(({ kind, label, side, slot, dialog, href, name }) => (
      <li
        class:list={['icon', `icon--${side}`, { 'icon--bottom': slot < 0 }]}
        style={`--slot: ${slot}`}
        aria-hidden={dialog || href ? undefined : 'true'}
      >
        {dialog && (
          <button
            class="icon__button"
            type="button"
            aria-controls={dialog}
            aria-haspopup="dialog"
            aria-label={name}
            data-dialog-open={dialog}
          />
        )}
        {href && <a class="icon__button" href={href} aria-label={name} />}
        <svg viewBox="0 0 32 32" shape-rendering="crispEdges" aria-hidden="true">
          {kind === 'disk' && (
            <>
              <path d="M2 10h28v14H2z" fill="#fff" />
              <path d="M2 9h28v1H2zM2 24h28v1H2zM1 10h1v14H1zM30 10h1v14h-1zM2 25h28v1H2z" />
              <path d="M5 19h14v2H5zM24 19h3v2h-3z" />
            </>
          )}
          {kind === 'folder' && (
            <>
              <path d="M3 9h10v3h16v16H3z" fill="#fff" />
              <path d="M3 8h10v1H3zM13 9h1v2h-1zM14 11h15v1H14zM2 9h1v19H2zM29 12h1v16h-1zM3 28h26v1H3zM3 14h26v1H3z" />
            </>
          )}
          {kind === 'document' && (
            <>
              <path d="M7 3h13l6 6v20H7z" fill="#fff" />
              <path d="M7 2h13v1H7zM6 3h1v26H6zM7 29h19v1H7zM26 9h1v20h-1zM20 3h1v1h-1zM21 4h1v1h-1zM22 5h1v1h-1zM23 6h1v1h-1zM24 7h1v1h-1zM25 8h1v1h-1zM19 3h1v6h-1zM20 8h6v1h-6z" />
              <path d="M10 13h12v1H10zM10 16h12v1H10zM10 19h12v1H10zM10 22h8v1h-8z" />
            </>
          )}
          {kind === 'globe' && (
            <>
              <path d="M12 5h8v1H12zM10 6h12v1H10zM8 7h16v1H8zM7 8h18v1H7zM7 9h18v1H7zM6 10h20v1H6zM6 11h20v1H6zM5 12h22v1H5zM5 13h22v1H5zM5 14h22v1H5zM5 15h22v1H5zM5 16h22v1H5zM5 17h22v1H5zM5 18h22v1H5zM5 19h22v1H5zM6 20h20v1H6zM6 21h20v1H6zM7 22h18v1H7zM7 23h18v1H7zM8 24h16v1H8zM10 25h12v1H10zM12 26h8v1H12z" fill="#fff" />
              <path d="M12 4h8v1H12zM10 5h2v1H10zM20 5h2v1H20zM8 6h2v1H8zM22 6h2v1H22zM7 7h1v1H7zM24 7h1v1H24zM6 8h1v1H6zM25 8h1v1H25zM6 9h1v1H6zM25 9h1v1H25zM5 10h1v1H5zM26 10h1v1H26zM5 11h1v1H5zM26 11h1v1H26zM4 12h1v1H4zM27 12h1v1H27zM4 13h1v1H4zM27 13h1v1H27zM4 14h1v1H4zM27 14h1v1H27zM4 15h1v1H4zM27 15h1v1H27zM4 16h1v1H4zM27 16h1v1H27zM4 17h1v1H4zM27 17h1v1H27zM4 18h1v1H4zM27 18h1v1H27zM4 19h1v1H4zM27 19h1v1H27zM5 20h1v1H5zM26 20h1v1H26zM5 21h1v1H5zM26 21h1v1H26zM6 22h1v1H6zM25 22h1v1H25zM6 23h1v1H6zM25 23h1v1H25zM7 24h1v1H7zM24 24h1v1H24zM8 25h2v1H8zM22 25h2v1H22zM10 26h2v1H10zM20 26h2v1H20zM12 27h8v1H12z" />
              <path d="M15 5h1v22h-1zM13 5h1v1h-1zM18 5h1v1h-1zM13 6h1v1h-1zM18 6h1v1h-1zM12 7h1v1h-1zM19 7h1v1h-1zM12 8h1v1h-1zM19 8h1v1h-1zM12 9h1v1h-1zM19 9h1v1h-1zM11 10h1v1h-1zM20 10h1v1h-1zM11 11h1v1h-1zM20 11h1v1h-1zM11 12h1v1h-1zM20 12h1v1h-1zM11 13h1v1h-1zM20 13h1v1h-1zM11 14h1v1h-1zM20 14h1v1h-1zM11 15h1v1h-1zM20 15h1v1h-1zM11 16h1v1h-1zM20 16h1v1h-1zM11 17h1v1h-1zM20 17h1v1h-1zM11 18h1v1h-1zM20 18h1v1h-1zM11 19h1v1h-1zM20 19h1v1h-1zM11 20h1v1h-1zM20 20h1v1h-1zM11 21h1v1h-1zM20 21h1v1h-1zM12 22h1v1h-1zM19 22h1v1h-1zM12 23h1v1h-1zM19 23h1v1h-1zM12 24h1v1h-1zM19 24h1v1h-1zM13 25h1v1h-1zM18 25h1v1h-1zM13 26h1v1h-1zM18 26h1v1h-1zM6 10h20v1H6zM5 15h22v1H5zM6 21h20v1H6z" />
            </>
          )}
          {kind === 'trash' && (
            <>
              {/* odd widths (can 17px inside, lid 23px) so the middle rib sits exactly centred */}
              <path d="M8 9h17v20H8zM6 7h21v2H6zM13 4h7v2h-7z" fill="#fff" />
              <path d="M13 3h7v1h-7zM12 4h1v2h-1zM20 4h1v2h-1zM5 6h23v1H5zM5 7h1v2H5zM27 7h1v2h-1zM5 9h23v1H5zM7 10h1v19H7zM25 10h1v19h-1zM8 29h17v1H8z" />
              <path d="M11 12h1v15h-1zM16 12h1v15h-1zM21 12h1v15h-1z" />
            </>
          )}
        </svg>
        <span class="icon__label" aria-hidden="true">{label}</span>
      </li>
    ))
  }
</ul>

<style>
  .icons {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    pointer-events: none;
  }

  .icon {
    --step: 104px;

    position: absolute;
    top: calc(40px + var(--slot) * var(--step));
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 96px;
  }

  .icon--bottom {
    top: auto;
    bottom: calc(32px + (-1 - var(--slot)) * var(--step));
  }

  .icon--left {
    left: 24px;
  }

  .icon--right {
    right: 24px;
  }

  /* clickable icon: the whole icon is the button (a covering hit area) */
  .icon__button {
    position: absolute;
    inset: 0;
    z-index: 1;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
  }

  .icon:has(.icon__button:hover) .icon__label,
  .icon:has(.icon__button:focus-visible) .icon__label {
    background: var(--color-black);
    color: var(--color-white);
  }

  .icon svg {
    width: 48px;
    height: 48px;
    image-rendering: pixelated;
  }

  .icon__label {
    padding: 0 4px;
    background: var(--color-white);
    color: var(--color-black);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    font-variation-settings: normal;
    white-space: nowrap;
  }

  /* When the window gets too narrow, the icons would sit under the content:
     then only the XD logo stays. */
  @media (max-width: 1199px) {
    .icons {
      display: none;
    }
  }
</style>
