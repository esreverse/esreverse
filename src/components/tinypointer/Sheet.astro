---
/**
 * A landscape sheet of paper in a classic black-and-white document window,
 * with the feature's headline above it (slot "title"). Each sheet unlocks its
 * feature: inside the sheet the visitor can try it with the hand (draw,
 * rainbow ink, number stamps, arrows, zoom loupe). The sheet clips the ink.
 * Below the window: the shortcut that does the same in the app.
 */
interface Props {
  feature: 'draw' | 'rainbow' | 'stamp' | 'arrow' | 'zoom';
  /** Call to action in the middle of the sheet (not shown on the zoom sheet) */
  hint: string;
}
const { feature, hint } = Astro.props;

const windowTitles = { draw: 'Draw', rainbow: 'Rainbow', stamp: 'Stamps', arrow: 'Arrows', zoom: 'Zoom' };

---

<figure class="sheet-wrap">
  <slot name="title" />
  <div class="window">
    <div class="window__bar" aria-hidden="true">
      <span class="window__close"></span>
      <span class="window__title">{windowTitles[feature]}</span>
    </div>
    {
      feature === 'zoom' ? (
        <article class="sheet sheet--zoom" data-sheet={feature}>
          <canvas class="sheet__ants" aria-hidden="true" />
          <div class="loupe" aria-hidden="true">
            <div class="loupe__lens">
              <canvas class="loupe__ants" />
            </div>
          </div>
        </article>
      ) : (
        <article class="sheet" data-sheet={feature}>
          <p class="sheet__hint">{hint}</p>
          <canvas class="sheet__ink" aria-hidden="true" />
        </article>
      )
    }
  </div>
  <figcaption class="sheet__shortcut">
    <slot name="shortcut" />
  </figcaption>
</figure>

<script>
  import { initSheets } from './sheet-ink';
  initSheets();
</script>

<style>
  .sheet-wrap {
    display: grid;
    justify-items: start;
    gap: 14px;
    width: min(880px, 100%, 130svh);
    margin: 0;
  }

  /* --- Classic window: 1px frame, hard 1-bit shadow, plain title bar --- */
  .window {
    width: 100%;
    border: 1px solid var(--color-black);
    background: var(--color-white);
    box-shadow: 2px 2px 0 var(--color-black);
  }

  .window__bar {
    position: relative;
    display: grid;
    place-items: center;
    height: 22px;
    padding: 4px 3px;
    border-bottom: 1px solid var(--color-black);
    background: var(--color-white);
  }

  .window__close {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 13px;
    height: 13px;
    translate: 0 -50%;
    border: 1px solid var(--color-black);
    background: var(--color-white);
    box-shadow: 0 0 0 2px var(--color-white);
  }

  .window__title {
    padding: 0 8px;
    background: var(--color-white);
    color: var(--color-black);
    font-size: 13px;
    line-height: 14px;
    font-weight: 700;
    font-variation-settings: normal;
  }

  .sheet {
    position: relative;
    width: 100%;
    aspect-ratio: 297 / 210;
    overflow: hidden; /* the sheet masks the ink */
    display: grid;
    place-items: center;
    padding: clamp(20px, 5%, 48px);
    background: var(--color-white);
    color: var(--color-black);
    /* the finger draws on the sheet instead of scrolling the page; scrolling
       works on the space around the sheets */
    touch-action: none;
  }

  .sheet__hint {
    text-align: center;
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.75;
    opacity: 0.55;
  }

  /* --- Zoom: ants and loupe --- */
  .sheet--zoom {
    display: block;
    padding: 0;
    cursor: none;
  }

  /* The hand turns into this loupe over the sheet: 3× magnification inside a
     thick Liquid Glass ring (blurred, brightened backdrop with light edges),
     modelled on the app's loupe. */
  .loupe {
    --size: 220px;
    --ring: 14px;
    --zoom: 3;

    position: absolute;
    z-index: 1;
    left: 0;
    top: 0;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: rgb(0 0 0 / 0.1); /* grey glass ring */
    -webkit-backdrop-filter: blur(10px) saturate(1.8) brightness(1.08);
    backdrop-filter: blur(10px) saturate(1.8) brightness(1.08);
    box-shadow:
      inset 0 1.5px 1px rgb(255 255 255 / 0.85),
      inset 0 -1.5px 2px rgb(0 0 0 / 0.18),
      inset 0 0 0 0.5px rgb(255 255 255 / 0.6),
      0 0 0 0.5px rgb(0 0 0 / 0.2),
      0 10px 28px rgb(0 0 0 / 0.28);
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity 0.15s,
      scale 0.2s var(--ease-out);
  }

  .loupe__lens {
    position: absolute;
    inset: var(--ring);
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-white);
    box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.25);
  }

  .loupe[data-on] {
    opacity: 1;
    scale: 1;
  }

  .sheet__ants,
  .loupe__ants {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .sheet__ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* --- App shortcut: directly on the desktop pattern --- */
  .sheet__shortcut {
    color: var(--color-black);
    font-family: var(--font-mono);
    font-variation-settings: normal;
    font-size: 0.75rem; /* same as the page footer */
    line-height: 1.75;
  }

  .sheet__shortcut :global(kbd) {
    display: inline-block;
    min-width: 1.9em;
    margin-inline: 0.2em;
    padding: 0.05em 0.6em;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.1);
    font: inherit;
    line-height: 1.4;
    font-weight: 500;
    text-align: center;
  }

  /* Parallax: headline, window and shortcut travel up together as one group,
     a little slower than the page. CSS scroll-driven animation, no JS. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      /* longhands only, see .reveal in global.css */
      .sheet-wrap {
        animation-name: sheet-settle;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes sheet-settle {
    from {
      translate: 0 18vh;
    }
    to {
      translate: 0 0;
    }
  }
</style>
