---
/**
 * A landscape sheet of paper lying on the "desktop", with the feature's
 * headline above it (slot "title"). Each sheet unlocks its feature: inside the sheet the visitor can try it with the
 * hand (draw, rainbow ink, number stamps, arrows). The sheet clips the ink.
 * Below the sheet: the shortcut that does the same in the app.
 */
interface Props {
  feature: 'draw' | 'rainbow' | 'stamp' | 'arrow';
  /** Call to action at the bottom left of the sheet */
  hint: string;
}
const { feature, hint } = Astro.props;
---

<figure class="sheet-wrap">
  <slot name="title" />
  <article class="sheet" data-sheet={feature}>
    <p class="sheet__hint">{hint}</p>
    <canvas class="sheet__ink" aria-hidden="true"></canvas>
  </article>
  <figcaption class="sheet__shortcut">
    <slot name="shortcut" />
  </figcaption>
</figure>

<script>
  import { initSheets } from "./sheet-ink";
  initSheets();
</script>

<style>
  .sheet-wrap {
    display: grid;
    justify-items: start;
    gap: 14px;
    width: min(880px, 100%, 130svh);
    margin: 0;
  }

  .sheet {
    position: relative;
    width: 100%;
    aspect-ratio: 297 / 210;
    overflow: hidden; /* the sheet masks the ink */
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(20px, 5%, 48px);
    border-radius: 4px;
    background: #fffefa;
    color: var(--color-black);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 4px 12px rgb(20 20 60 / 0.06);
    touch-action: pan-y;
  }

  /* secondary text: hint on the sheet and the app shortcut below it */
  .sheet__hint,
  .sheet__shortcut {
    font-size: clamp(0.875rem, 1.6vw, 1.125rem);
    line-height: 1.75;
    opacity: 0.55;
  }

  .sheet__shortcut {
    font-size: clamp(0.75rem, 1.4vw, 1rem); /* 2px smaller than the hint */
  }

  .sheet__ink {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sheet__shortcut :global(kbd) {
    display: inline-block;
    min-width: 1.9em;
    margin-inline: 0.2em;
    padding: 0.05em 0.6em;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.1);
    font: inherit;
    line-height: 1.4;
    font-weight: 600;
    text-align: center;
  }

  /* DARK MODE – disabled while the light mode is being refined.
   Remove this comment wrapper to switch it back on.
@media (prefers-color-scheme: dark) {
    .sheet__shortcut :global(kbd) {
      background: rgb(255 255 255 / 0.12);
      box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.4);
    }
  }
*/

  /* Parallax: the sheet travels a little slower than the page.
     CSS scroll-driven animation, no JS. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .sheet {
        animation: sheet-settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
    }
  }

  @keyframes sheet-settle {
    from {
      translate: 0 18vh;
    }
    to {
      translate: 0 0;
    }
  }
</style>
