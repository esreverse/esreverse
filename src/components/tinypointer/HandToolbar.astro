---
/**
 * The pointer part of the TinyPointer toolbar (as in the app, without colours
 * and sound): pick one of a few hands. Appears once the hand is on screen.
 * Selecting a hand dispatches `tinypointer:hand` with the image sources.
 */
import { Image } from 'astro:assets';
import RetroDialog from './RetroDialog.astro';

export interface HandChoice {
  id: string;
  label: string;
  thumb: ImageMetadata;
  src: string;
  srcset: string;
  /** Repeating slice of the stick (see the page's .hand-stick) */
  stick: string;
  /** Fingertip position as fractions of the image */
  tipX: number;
  tipY: number;
}

interface Props {
  hands: HandChoice[];
}
const { hands } = Astro.props;
---

<div class="toolbar" role="toolbar" aria-label="Choose a hand" data-hand-toolbar>
  {
    hands.map((hand, i) => (
      <button
        class="toolbar__hand"
        type="button"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-src={hand.src}
        data-srcset={hand.srcset}
        data-stick={hand.stick}
        data-tip-x={hand.tipX}
        data-tip-y={hand.tipY}
        data-cursor-grow
      >
        <Image src={hand.thumb} width={56} height={70} alt="" />
        <span class="visually-hidden">{hand.label}</span>
      </button>
    ))
  }
  <span class="toolbar__divider" aria-hidden="true"></span>
  <button class="toolbar__add" type="button" aria-controls="own-hand" aria-haspopup="dialog" data-dialog-open="own-hand">
    <svg viewBox="0 0 20 20" aria-hidden="true">
      <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
    </svg>
    <span class="visually-hidden">Add your own hand</span>
  </button>
</div>

<RetroDialog id="own-hand" title="Make your own hand">
  <p>
    In TinyPointer you can turn any idea into your own hand, for example with ChatGPT. Open
    <strong>Settings → Pointers → Make your own…</strong> and:
  </p>
  <ol>
    <li>Describe your hand, e.g. “knitted wool in mustard yellow”.</li>
    <li>
      Click <strong>Open in ChatGPT</strong> (or copy the prompt for another image tool) and download the
      result as a PNG with a transparent background.
    </li>
    <li>Drop the PNG into TinyPointer. Your hand is ready in the toolbar.</li>
  </ol>
</RetroDialog>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-hand-toolbar]');
  toolbar?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.toolbar__hand');
    if (!button) return;
    toolbar.querySelectorAll('.toolbar__hand').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    window.dispatchEvent(
      new CustomEvent('tinypointer:hand', {
        detail: { ...button.dataset },
      }),
    );
  });
</script>

<style>
  .toolbar {
    position: fixed;
    z-index: 2; /* below the hand, above the sheets */
    left: 50%;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    /* the app's own toolbar look (deliberately not retro) */
    border-radius: 16px;
    background: rgb(28 28 30 / 0.92);
    box-shadow: 0 10px 30px rgb(0 0 0 / 0.25);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    translate: -50% calc(100% + 40px);
    opacity: 0;
    transition:
      translate 0.5s var(--ease-out),
      opacity 0.3s;
  }

  /* shown while the sheets are on screen (set by the page script) */
  :global(html[data-toolbar]) .toolbar {
    translate: -50% 0;
    opacity: 1;
  }

  .toolbar__hand {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__hand:hover {
    background: rgb(255 255 255 / 0.08);
  }

  .toolbar__hand[aria-pressed='true'] {
    background: rgb(255 255 255 / 0.18);
  }

  .toolbar__divider {
    width: 1px;
    height: 32px;
    margin-inline: 4px;
    background: rgb(255 255 255 / 0.2);
  }

  .toolbar__add {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--color-white);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__add:hover,
  .toolbar__add:focus-visible {
    background: rgb(255 255 255 / 0.08);
  }

  .toolbar__add svg {
    width: 22px;
  }

  .toolbar__hand :global(img) {
    width: 32px;
    height: auto;
  }
</style>
