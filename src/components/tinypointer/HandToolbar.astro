---
/**
 * The pointer part of the TinyPointer toolbar (as in the app, without colours
 * and sound): pick one of a few hands. Appears once the hand is on screen.
 * Selecting a hand dispatches `tinypointer:hand` with the image sources.
 */
import { Image } from 'astro:assets';

export interface HandChoice {
  id: string;
  label: string;
  thumb: ImageMetadata;
  src: string;
  srcset: string;
  /** Repeating slice of the stick (see the page's .hand-stick) */
  stick: string;
  /** Fingertip position as fractions of the image */
  tipX: number;
  tipY: number;
}

interface Props {
  hands: HandChoice[];
}
const { hands } = Astro.props;
---

<div class="toolbar" role="toolbar" aria-label="Choose a hand" data-hand-toolbar>
  {
    hands.map((hand, i) => (
      <button
        class="toolbar__hand"
        type="button"
        aria-pressed={i === 0 ? 'true' : 'false'}
        data-src={hand.src}
        data-srcset={hand.srcset}
        data-stick={hand.stick}
        data-tip-x={hand.tipX}
        data-tip-y={hand.tipY}
        data-cursor-grow
      >
        <Image src={hand.thumb} width={56} height={70} alt="" />
        <span class="visually-hidden">{hand.label}</span>
      </button>
    ))
  }
</div>

<script>
  const toolbar = document.querySelector<HTMLElement>('[data-hand-toolbar]');
  toolbar?.addEventListener('click', (event) => {
    const button = (event.target as Element).closest<HTMLButtonElement>('.toolbar__hand');
    if (!button) return;
    toolbar.querySelectorAll('.toolbar__hand').forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
    window.dispatchEvent(
      new CustomEvent('tinypointer:hand', {
        detail: { ...button.dataset },
      }),
    );
  });
</script>

<style>
  .toolbar {
    position: fixed;
    z-index: 2; /* below the hand, above the sheets */
    left: 50%;
    bottom: 24px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    /* classic palette window: white, 1px frame, hard 1-bit shadow */
    border: 1px solid var(--color-black);
    border-radius: 0;
    background: var(--color-white);
    box-shadow: 2px 2px 0 var(--color-black);
    translate: -50% calc(100% + 40px);
    opacity: 0;
    transition:
      translate 0.5s var(--ease-out),
      opacity 0.3s;
  }

  /* shown while the sheets are on screen (set by the page script) */
  :global(html[data-toolbar]) .toolbar {
    translate: -50% 0;
    opacity: 1;
  }

  .toolbar__hand {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    border: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .toolbar__hand:hover {
    border-color: var(--color-black);
  }

  /* selected: inverted, like a highlighted icon */
  .toolbar__hand[aria-pressed='true'] {
    background: var(--color-black);
  }

  .toolbar__hand :global(img) {
    width: 32px;
    height: auto;
  }
</style>
