---
/**
 * Small white dot following the pointer (blend mode "difference"), as on the
 * original site. Only for precise pointers and when motion is welcome.
 */
---

<div class="cursor" aria-hidden="true" data-cursor></div>

<script>
  const dot = document.querySelector<HTMLElement>('[data-cursor]');
  const enabled = window.matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)');

  if (dot && enabled.matches) {
    window.addEventListener(
      'pointermove',
      (event) => {
        dot.style.translate = `${event.clientX}px ${event.clientY}px`;
        dot.dataset.visible = '';
      },
      { passive: true },
    );
    document.documentElement.addEventListener('pointerleave', () => delete dot.dataset.visible);
  }
</script>

<style>
  .cursor {
    position: fixed;
    z-index: 1000;
    top: -8px;
    left: -8px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--color-white);
    mix-blend-mode: difference;
    pointer-events: none;
    opacity: 0;
    transition:
      opacity 0.2s,
      translate 0.12s var(--ease-out);
  }

  .cursor[data-visible] {
    opacity: 1;
  }
</style>
