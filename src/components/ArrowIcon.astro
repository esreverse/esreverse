---
/**
 * Stroked arrow used in buttons and carousel controls.
 * `tight` crops the whitespace around the glyph (for inline use in pill buttons).
 */
interface Props {
  direction?: 'left' | 'right';
  tight?: boolean;
}
const { direction = 'right', tight = false } = Astro.props;
const path =
  direction === 'right'
    ? 'M10.75 6.25 14.5 10m0 0-3.75 3.75M14.5 10h-9'
    : 'M9.25 6.25 5.5 10m0 0 3.75 3.75M5.5 10h9';
---

<svg viewBox={tight ? '4 4 12 12' : '0 0 20 20'} fill="none" aria-hidden="true" focusable="false">
  <path
    d={path}
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    vector-effect="non-scaling-stroke"></path>
</svg>
