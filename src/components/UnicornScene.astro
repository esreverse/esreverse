---
import { url } from '../lib/url';
/**
 * Animated WebGL background made with Unicorn Studio ("Flow gradient").
 *
 * Self-hosted: the runtime (`public/unicorn/unicornStudio-*.umd.js`) and the
 * exported scene (`public/unicorn/flow-gradient.json`) are served from this
 * site – no third-party requests.
 *
 * This component is the single place that knows about Unicorn Studio, so it
 * can later be swapped for a custom effect without touching the sections.
 * Without JS or with `prefers-reduced-motion`, only the static fill shows.
 */
interface Props {
  class?: string;
  scene?: string;
}
const { class: className, scene = url('/unicorn/flow-gradient.json') } = Astro.props;
---

<div
  class:list={['unicorn-scene', className]}
  data-us-project-src={scene}
  data-us-scale="1"
  data-us-dpi="1.5"
  data-us-lazyload="true"
  data-us-production="true"
  aria-hidden="true"
>
</div>

<script>
  const RUNTIME = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/unicorn/unicornStudio-1.3.2.umd.js`;

  type UnicornStudioApi = { init: () => Promise<unknown> };

  function loadRuntime(): Promise<UnicornStudioApi> {
    return new Promise((resolve, reject) => {
      const existing = (window as unknown as { UnicornStudio?: UnicornStudioApi }).UnicornStudio;
      if (existing) return resolve(existing);
      const script = document.createElement('script');
      script.src = RUNTIME;
      script.async = true;
      script.onload = () =>
        resolve((window as unknown as { UnicornStudio: UnicornStudioApi }).UnicornStudio);
      script.onerror = reject;
      document.head.append(script);
    });
  }

  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reducedMotion && document.querySelector('.unicorn-scene')) {
    // Don't compete with the first paint: start once the browser is idle.
    const start = () => loadRuntime().then((us) => us.init()).catch(() => {});
    if ('requestIdleCallback' in window) {
      requestIdleCallback(start, { timeout: 1500 });
    } else {
      setTimeout(start, 300);
    }
  }
</script>

<style>
  .unicorn-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .unicorn-scene :global(canvas) {
    width: 100% !important;
    height: 100% !important;
  }
</style>
